# Environment Settings
QBO_ENVIRONMENT=sandbox

# ----------------------------------------------------
# Payless Motors
# ----------------------------------------------------
PAYLESS_QBO_CLIENT_ID=your_payless_client_id_here
PAYLESS_QBO_CLIENT_SECRET=your_payless_client_secret_here
PAYLESS_QBO_REDIRECT_URI=http://localhost:3000/auth/qbo/payless/callback
PAYLESS_QBO_REALM_ID=your_payless_realm_id_here

# ----------------------------------------------------
# Royal Motors
# ----------------------------------------------------
ROYAL_QBO_CLIENT_ID=your_royal_client_id_here
ROYAL_QBO_CLIENT_SECRET=your_royal_client_secret_here
ROYAL_QBO_REDIRECT_URI=http://localhost:3000/auth/qbo/royal/callback
ROYAL_QBO_REALM_ID=your_royal_realm_id_here

# ----------------------------------------------------
# TQM
# ----------------------------------------------------
TQM_QBO_CLIENT_ID=your_tqm_client_id_here
TQM_QBO_CLIENT_SECRET=your_tqm_client_secret_here
TQM_QBO_REDIRECT_URI=http://localhost:3000/auth/qbo/tqm/callback
TQM_QBO_REALM_ID=your_tqm_realm_id_here

# ----------------------------------------------------
# Great Motor Auto
# ----------------------------------------------------
GMA_QBO_CLIENT_ID=your_gma_client_id_here
GMA_QBO_CLIENT_SECRET=your_gma_client_secret_here
